extends Node
## Autoload: tuning numbers, enemy kinds and ability definitions from game/data/*.json.
## Gameplay scripts read from here instead of holding constants (coding standard: values are data).

var balance: Dictionary = {}
var enemies: Dictionary = {}
var abilities: Dictionary = {}
var construct_tiers: Array = []
## The words constructs carry (Brent 2026-11-04, design/14 section 14): constructs.json "words",
## generated by tools/runes/construct_words.py - id -> {label, tier, runes, meaning, affinity, form}.
var construct_words: Dictionary = {}
## The six concepts of 2026-09 by tier -> the word each now is (old saves and data).
var construct_legacy: Dictionary = {}
## How many runes a word of each tier carries (vestige 1 ... asura 5).
var construct_tier_runes: Dictionary = {}
var _wild: Dictionary = {}
var items_file: Dictionary = {}
var items: Dictionary = {}
var creation: Dictionary = {}
var _statuses: Dictionary = {}
var _player_states: Dictionary = {}
var _tempering: Dictionary = {}
var _affinities: Dictionary = {}
var _prime_default: Array = []
var _zones: Dictionary = {}
## What the real character bodies wear: data/wardrobe.json (see scripts/art/real_character.gd).
var wardrobe: Dictionary = {}
## How each enemy kind looks as a real body: data/enemy_looks.json.
var enemy_looks: Dictionary = {}
## Skill points and the skill tree: data/skill_tree.json (design/08).
var skill_tree: Dictionary = {}
## The town as a place: data/town.json (design/08, scripts/town_builder.gd).
var town: Dictionary = {}
## Crafting step 1: data/crafting.json, generated from the drafts (design/12, scripts/crafting.gd).
var crafting: Dictionary = {}
## Runes and the rules of rune words: data/runes.json, generated from design/runes-workbook.xlsx
## by tools/runes/export_runes_json.py (design/14 section 7; rules in scripts/runes.gd).
var runes: Dictionary = {}
## Where runes are found (design/14 section 8): data/rune_discovery.json, generated by
## tools/runes/rune_sources.py. Read by the player's rune discovery.
var rune_discovery: Dictionary = {}
## The rune rule set in force and a test override (see Runes.active). Held here, on the autoload,
## rather than in static variables, so they are let go when the game closes.
var rune_rules: RefCounted = null
var rune_rules_override: RefCounted = null
## The data schema (data/schema.json, scripts/data_schema.gd; docs/architecture/data-schema.md): optional keys are
## read through opt(), and every data file is checked against it once, when it loads.
var schema := DataSchema.new()
## What the load-time check found ("<file>.json <where>: <what>", each also pushed as an error). Empty when the data
## is clean; the self-test and res://tests/load_all.tscn fail on anything here.
var data_errors: Array[String] = []
## How long the check took, in milliseconds (docs/architecture/data-schema.md).
var check_ms: float = 0.0
## The schema's defaults (kind -> {key: default}) and variants, held here for opt().
var _defaults: Dictionary = {}
var _variants: Dictionary = {}


## Loaded in the constructor: the singleton name resolves before the node enters the tree,
## and the main scene's member initialisers may read from it that early.
func _init() -> void:
	UserDirMigration.run()
	_ensure()


func _ensure() -> void:
	if not balance.is_empty():
		return
	var raw: Dictionary = {}          # every file as parsed, for the schema check below
	balance = _load("res://data/balance.json")
	raw["balance"] = balance
	raw["enemies"] = _load("res://data/enemies.json")
	enemies = raw["enemies"].get("enemies", {})
	var ab_file: Dictionary = _load("res://data/abilities.json")
	raw["abilities"] = ab_file
	abilities = ab_file.get("abilities", {})
	var con: Dictionary = _load("res://data/constructs.json")
	raw["constructs"] = con
	construct_tiers = con.get("tiers", [])
	construct_words = con.get("words", {})
	construct_legacy = con.get("legacy", {})
	construct_tier_runes = con.get("tier_runes", {})
	_wild = con.get("wild", {})
	items_file = _load("res://data/items.json")
	raw["items"] = items_file
	items = (items_file.get("items", {}) as Dictionary).duplicate()      # items_file keeps only the live items (drops read it)
	creation = _load("res://data/creation.json")
	raw["creation"] = creation
	var st_file: Dictionary = _load("res://data/statuses.json")
	raw["statuses"] = st_file
	_statuses = st_file.get("statuses", {})
	_player_states = st_file.get("player_states", {})
	_tempering = _load("res://data/tempering.json")
	raw["tempering"] = _tempering
	var aff: Dictionary = _load("res://data/affinities.json")
	raw["affinities"] = aff
	_affinities = aff.get("affinities", {})
	_prime_default = aff.get("prime_default", [])
	raw["zones"] = _load("res://data/zones.json")
	_zones = raw["zones"].get("zones", {})
	wardrobe = _load("res://data/wardrobe.json")
	raw["wardrobe"] = wardrobe
	enemy_looks = _load("res://data/enemy_looks.json")
	raw["enemy_looks"] = enemy_looks
	skill_tree = _load("res://data/skill_tree.json")
	raw["skill_tree"] = skill_tree
	town = _load("res://data/town.json")
	raw["town"] = town
	crafting = _load("res://data/crafting.json")
	raw["crafting"] = crafting
	runes = _load("res://data/runes.json")
	raw["runes"] = runes
	rune_discovery = _load("res://data/rune_discovery.json")
	raw["rune_discovery"] = rune_discovery
	# its materials, tools and kits join the item list; a live id in items.json always wins
	var craft_items: Dictionary = crafting.get("items", {})
	for id: String in craft_items:
		if not items.has(id):
			items[id] = craft_items[id]
	# scrolls for the drafted skills (generated by tools/skills/emit_abilities.py), the same way
	raw["scrolls"] = _load("res://data/scrolls.json")
	var scroll_items: Dictionary = raw["scrolls"].get("items", {})
	for id: String in scroll_items:
		if not items.has(id):
			items[id] = scroll_items[id]
	raw["talents"] = _load("res://data/talents.json")          # TalentDB's; loaded here only to be checked
	_check(raw)


## Checks every data file against the schema once (unknown keys, missing required keys, wrong types, ids that point
## nowhere) and pushes an error per problem; the list stays in data_errors.
func _check(raw: Dictionary) -> void:
	var t0: int = Time.get_ticks_usec()
	data_errors = []
	if not schema.load_file(_load(DataSchema.SCHEMA_PATH)):
		data_errors.append("schema.json: cannot be read")
	else:
		_defaults = schema.defaults
		_variants = schema.variants
		data_errors = schema.check(raw, _id_sets())
		data_errors.append_array(_check_by_hand())
	check_ms = float(Time.get_ticks_usec() - t0) / 1000.0
	for e: String in data_errors:
		push_error("GameData: " + e)


## The ids a reference may name, by target.
func _id_sets() -> Dictionary:
	var rune_ids: Dictionary = {}
	for part: String in ["base_runes", "universal_runes"]:
		for id: String in runes.get(part, {}):
			rune_ids[id] = true
	return {"ability": abilities, "status": _statuses, "player_state": _player_states, "item": items, "enemy": enemies, "affinity": _affinities,
		"rune": rune_ids, "word": construct_words, "station": crafting.get("stations", {}),
		"craft_skill": crafting.get("skills", {})}


## The references the schema's generic walk does not reach: tables keyed or filled by ids.
func _check_by_hand() -> Array[String]:
	var out: Array[String] = []
	var ids: Dictionary = _id_sets()
	var anchor: Dictionary = runes.get("skill_anchor", {})
	for ab: String in anchor:
		if not abilities.has(ab):
			out.append("runes.json skill_anchor: '%s' is not a known ability" % ab)
		if not (ids["rune"] as Dictionary).has(anchor[ab]):
			out.append("runes.json skill_anchor.%s: '%s' is not a known rune" % [ab, str(anchor[ab])])
	var start: Dictionary = (rune_discovery.get("start", {}) as Dictionary).get("affinity_runes", {})
	for a: String in start:
		if not _affinities.has(a):
			out.append("rune_discovery.json start.affinity_runes: '%s' is not a known affinity" % a)
		out.append_array(_unknown_runes(start[a], "rune_discovery.json start.affinity_runes." + a, ids["rune"]))
	var cw: Dictionary = (rune_discovery.get("construct", {}) as Dictionary).get("words", {})
	var rune_ids: Dictionary = ids["rune"]
	for w: String in cw:
		if not construct_words.has(w):
			out.append("rune_discovery.json construct.words: '%s' is not a known construct word" % w)
		var entry: Dictionary = cw[w]
		var lists: Array = [entry.get("universal", [])]
		lists.append_array((entry.get("base", {}) as Dictionary).values())
		for list: Variant in lists:          # (inline: thousands of short lists, checked on every start)
			for r: Variant in list:
				if not rune_ids.has(r):
					out.append("rune_discovery.json construct.words.%s: '%s' is not a known rune" % [w, str(r)])
	var kills: Dictionary = rune_discovery.get("kills", {})
	for part2: String in ["chance_by_kind", "by_kind"]:
		for k: String in kills.get(part2, {}):
			if not enemies.has(k):
				out.append("rune_discovery.json kills.%s: '%s' is not a known enemy" % [part2, k])
	for k2: String in enemy_looks:
		if not k2.begins_with("_") and not enemies.has(k2):
			out.append("enemy_looks.json: '%s' is not a known enemy" % k2)
	return out


static func _unknown_runes(list: Variant, where: String, rune_ids: Dictionary) -> Array[String]:
	var out: Array[String] = []
	if not (list is Array):
		out.append("%s: not a list of rune ids" % where)
		return out
	for r: Variant in list:
		if not rune_ids.has(r):
			out.append("%s: '%s' is not a known rune" % [where, str(r)])
	return out


## An optional key of a data entry (or of a copy of one, such as an ability's patched stats or a buff) of schema kind
## `kind`: the entry's value, else the default the schema gives that key (data/schema.json; `variant` names a call
## site's own default where two sites read the same key differently). Read data this way, never with
## .get("key", <number>), so the default lives in one place and a misspelt key is an error.
func opt(d: Dictionary, kind: String, key: String, variant: String = "") -> Variant:
	# one line on purpose: it runs about a thousand times a frame in a big fight. A kind, key or variant the schema
	# does not name is a script error here (tests/load_all.tscn checks every call against the schema).
	return d.get(key, _defaults[kind][key] if variant == "" else _variants[kind][key][variant])


## A tempering technique definition, or {} if the id is unknown.
func technique(id: String) -> Dictionary:
	_ensure()
	return (_tempering.get("techniques", {}) as Dictionary).get(id, {})


func technique_ids() -> Array:
	_ensure()
	return (_tempering.get("techniques", {}) as Dictionary).keys()


## The numbers for one training session.
func tempering_session() -> Dictionary:
	_ensure()
	return _tempering.get("session", {})


## An affinity definition (label, color, desc), or {} if the id is unknown.
func affinity(id: String) -> Dictionary:
	_ensure()
	return _affinities.get(id, {})


## The affinities a character has when none were rolled for it (tests, bots, old saves).
func default_affinities() -> Array[String]:
	_ensure()
	var out: Array[String] = []
	for a: Variant in _prime_default:
		out.append(str(a))
	return out


## An overland zone definition (data/zones.json), or {} if the id is unknown.
func zone(id: String) -> Dictionary:
	_ensure()
	return _zones.get(id, {})


## A skill's place on its affinity's tree: {tier, col, requires}, or {} if it is on no tree.
func skill_node(ability_id: String) -> Dictionary:
	_ensure()
	var aff: String = str(ability(ability_id).get("affinity", ""))
	return ((skill_tree.get("trees", {}) as Dictionary).get(aff, {}) as Dictionary).get(ability_id, {})


## Every node of one affinity's tree: ability id -> {tier, col, requires}.
func skill_tree_of(aff: String) -> Dictionary:
	_ensure()
	return (skill_tree.get("trees", {}) as Dictionary).get(aff, {})


## The root skills (tier 1, no prerequisite) of these affinities, in tree order: what a new
## character picks its starting skills from.
func skill_roots(for_affinities: Array) -> Array[String]:
	_ensure()
	var out: Array[String] = []
	for a: Variant in for_affinities:
		var tree: Dictionary = skill_tree_of(str(a))
		for id: String in tree:
			if int(opt((tree[id] as Dictionary), "tree_node", "tier")) == 1 and ((tree[id] as Dictionary).get("requires", []) as Array).is_empty():
				out.append(id)
	return out


## What one townsperson is (data/town.json "folk"), by role; {} if nobody does that.
func town_folk(role: String) -> Dictionary:
	_ensure()
	for f: Dictionary in town.get("folk", []):
		if str(f.get("role", "")) == role:
			return f
	return {}


## A rune by id, base or universal: {id, name, character, valence, electronegativity, meaning, ...}
## (base runes also carry affinity, role and opposite). {} if the id is unknown.
func rune(id: String) -> Dictionary:
	_ensure()
	var base: Dictionary = runes.get("base_runes", {})
	if base.has(id):
		return base[id]
	return (runes.get("universal_runes", {}) as Dictionary).get(id, {})


## The base rune a skill is built on (its anchor), or "" if the data has none for it.
func skill_anchor(ability_id: String) -> String:
	_ensure()
	return str((runes.get("skill_anchor", {}) as Dictionary).get(ability_id, ""))


## An item definition, or {} if the id is unknown.
func item(id: String) -> Dictionary:
	_ensure()
	return items.get(id, {})


## The construct tier an ability at `stage` needs to advance (stage 0 -> "vestige").
func tier_for_stage(stage: int) -> String:
	_ensure()
	return str(construct_tiers[stage]) if stage >= 0 and stage < construct_tiers.size() else ""


## How a construct of `tier` behaves when met wild in the Netherecho.
func wild_construct(tier: String) -> Dictionary:
	_ensure()
	return _wild.get(tier, _wild.get("vestige", {}))


## The word a construct of `tier` carrying `id` holds: {id, label, tier, runes, meaning, affinity,
## form}; {} if there is none. An old concept id (one of the six of 2026-09) is resolved through the
## legacy table for that tier, so an old save's {tier, concept} still names a word.
func construct_word(tier: String, id: String) -> Dictionary:
	_ensure()
	var w: Dictionary = construct_words.get(id, {})
	if not w.is_empty() and (tier == "" or str(w.get("tier", "")) == tier):
		return w
	var old: Dictionary = construct_legacy.get(id, {})
	if old.has(tier):
		return construct_words.get(str(old[tier]), {})
	return {}


## The id a construct of `tier` carrying `id` should be stored under: the word's own id (an old
## concept id becomes the word it now is); "" if it names no word of that tier.
func construct_word_id(tier: String, id: String) -> String:
	return str(construct_word(tier, id).get("id", ""))


## Every word of `tier` ("" = all), in data order.
func construct_word_ids(tier: String = "") -> Array:
	_ensure()
	if tier == "":
		return construct_words.keys()
	return construct_words.keys().filter(func(id: Variant) -> bool: return str((construct_words[id] as Dictionary).get("tier", "")) == tier)


## Ability ids a new character with these affinities starts with, in hotbar order: each
## affinity's kit in turn.
func ability_loadout(for_affinities: Array) -> Array:
	_ensure()
	var out: Array = []
	for a: Variant in for_affinities:
		for id: Variant in affinity(str(a)).get("kit", []):
			out.append(str(id))
	return out


func affinity_ids() -> Array:
	_ensure()
	return _affinities.keys()


## The base affinities (affinities.json kind "base"; design/affinities/framework.md): the eight a
## character can be created with. Hybrids come only from ascension (Brent 2026-10-24).
func base_affinity_ids() -> Array[String]:
	var out: Array[String] = []
	for id: Variant in affinity_ids():
		if str(affinity(str(id)).get("kind", "base")) == "base":
			out.append(str(id))
	return out


## A hybrid's two base parents ([] for a base or an unknown id).
func affinity_parents(id: String) -> Array[String]:
	var out: Array[String] = []
	for p: Variant in affinity(id).get("parents", []):
		out.append(str(p))
	return out


## True if the game has this affinity to give: it is in affinities.json and has a kit of skills.
## (Holy and Unholy are in the framework but not in the game yet - never offered.)
func affinity_playable(id: String) -> bool:
	return not (affinity(id).get("kit", []) as Array).is_empty()


func affinity_color(id: String) -> Color:
	return Color(str(affinity(id).get("color", "9c917b")))


## A number from balance.json. Missing keys are a loud error, not a silent zero.
func num(section: String, key: String) -> float:
	_ensure()
	var sec: Variant = balance.get(section)
	if typeof(sec) != TYPE_DICTIONARY or not (sec as Dictionary).has(key):
		push_error("GameData: balance.%s.%s is not defined" % [section, key])
		return 0.0
	return float((sec as Dictionary)[key])


func inum(section: String, key: String) -> int:
	return int(num(section, key))


func enemy(kind: String) -> Dictionary:
	_ensure()
	if not enemies.has(kind):
		push_error("GameData: unknown enemy kind '%s'" % kind)
		return {}
	return enemies[kind]


## A status definition (stacks, lasts and the numbers its rule reads), or {} if unknown.
func status(id: String) -> Dictionary:
	_ensure()
	return _statuses.get(id, {})


## Every status id in statuses.json (aliases included), in file order.
func status_ids() -> Array[String]:
	_ensure()
	var out: Array[String] = []
	for id: Variant in _statuses:
		out.append(str(id))
	return out


## One of the player's own short states (statuses.json "player_states": Quickened), or {}.
func player_state(id: String) -> Dictionary:
	_ensure()
	return _player_states.get(id, {})


## Every player state id (statuses.json "player_states"), in data order.
func player_state_ids() -> Array[String]:
	_ensure()
	var out: Array[String] = []
	for id: Variant in _player_states:
		out.append(str(id))
	return out


func ability(id: String) -> Dictionary:
	_ensure()
	if not abilities.has(id):
		push_error("GameData: unknown ability '%s'" % id)
		return {}
	return abilities[id]


static func _load(path: String) -> Dictionary:
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		push_error("GameData: cannot open %s" % path)
		return {}
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("GameData: %s is not a JSON object" % path)
		return {}
	return parsed
