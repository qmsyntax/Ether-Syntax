class_name ConstructWords
extends RefCounted
## The words constructs carry (Brent 2026-11-04, design/14 section 14: "There should be vestiges for
## every rune word we have....and so on up the complexity ladder"). A vestige carries one rune, a
## remnant a two-rune word, a spirit three, an eidolon four, an asura five; the data is constructs.json
## "words" (GENERATED by tools/runes/construct_words.py), read through GameData.construct_word.
##
## A construct is still {tier, concept} wherever it is carried, saved or set as a keystone; "concept"
## now holds a word id (a rune id for a vestige: "WAT-1a"; an authored id above it: "undertow"). An
## old concept id (the six of 2026-09) still resolves, through the legacy table.
##
## Fit (Brent 2026-11-04): a word of universal runes fits any skill; one with an affinity rune fits
## only where that rune could be set - the game's own rule, Player.can_use_rune (a base rune of an
## affinity the character holds). Hybrids follow the same rule.
## Wild words (Brent: "wild spawns lean toward the player's affinities so drops stay useful"): a tier's
## words are drawn by class - the character's own affinities, universal, any other - with balance.json
## "nether" "word_weights".


## The word a construct carries ({} if none).
static func word(tier: String, id: String) -> Dictionary:
	return GameData.construct_word(tier, id)


## Its name: "Flood", "Undertow" (the id itself if the data has no such word).
static func label(tier: String, id: String) -> String:
	return str(word(tier, id).get("label", id.capitalize()))


## "Vestige of Flood", "Remnant of Acceleration".
static func title(tier: String, id: String) -> String:
	return "%s of %s" % [tier.capitalize(), label(tier, id)]


## "vestige of Flood" (in running text).
static func phrase(tier: String, id: String) -> String:
	return "%s of %s" % [tier, label(tier, id)]


## Its runes in order (rune ids).
static func runes(tier: String, id: String) -> Array[String]:
	var out: Array[String] = []
	for r: Variant in word(tier, id).get("runes", []):
		out.append(str(r))
	return out


## Its runes as glyphs and names: "ᚡ Ebb + ᚥ Drown".
static func spelling(tier: String, id: String) -> String:
	var parts: Array[String] = []
	for rid: String in runes(tier, id):
		var r: Dictionary = GameData.rune(rid)
		parts.append("%s %s" % [str(r.get("character", "?")), str(r.get("name", rid))])
	return " + ".join(PackedStringArray(parts))


## Its affinity ("" = universal: every rune of it is universal).
static func affinity(tier: String, id: String) -> String:
	return str(word(tier, id).get("affinity", ""))


## Every op of its runes, in word order (what a keystone of it applies).
static func ops(tier: String, id: String) -> Array:
	var out: Array = []
	for rid: String in runes(tier, id):
		out.append_array(GameData.rune(rid).get("ops", []))
	return out


## Its colour: its affinity's, or a pale neutral for a universal word.
static func color(tier: String, id: String) -> Color:
	var aff: String = affinity(tier, id)
	return GameData.affinity_color(aff) if aff != "" else NEUTRAL


const NEUTRAL := Color(0.78, 0.8, 0.86)


## Whether a word of `tier` / `id` fits a character holding `held` affinities: {ok, reason, text}.
## Reasons: "no_word" (the data has none), "affinity" (a rune of an affinity not held). The rule is
## Player.can_use_rune's, so a skill takes a keystone exactly where its runes could be set.
static func fits(tier: String, id: String, held: Array) -> Dictionary:
	var w: Dictionary = word(tier, id)
	if w.is_empty():
		return RuneRules.no("no_word", "There is no %s of '%s'." % [tier, id])
	for rid: String in runes(tier, id):
		var aff: String = str(GameData.rune(rid).get("affinity", ""))
		if aff != "" and not held.has(aff):
			var aff_name: String = str(GameData.affinity(aff).get("label", aff.capitalize()))
			return RuneRules.no("affinity", "The %s is a %s word (%s): you hold no %s, so it fits none of your skills." % [
				phrase(tier, id), aff_name.to_lower(), str(GameData.rune(rid).get("name", rid)), aff_name.to_lower()])
	return RuneRules.ok()


## The class a word falls in for a character holding `held`: "own", "universal" or "other".
static func word_class(tier: String, id: String, held: Array) -> String:
	var aff: String = affinity(tier, id)
	if aff == "":
		return "universal"
	return "own" if held.has(aff) else "other"


## A wild word of `tier` for a character holding `held` (balance.json nether "word_weights": each class
## by its weight, then any word of it at random; a class with no word gives its share to the rest).
## "" if the tier has no word at all.
static func pick_wild(tier: String, held: Array, rng: RandomNumberGenerator) -> String:
	var weights: Dictionary = (GameData.balance.get("nether", {}) as Dictionary).get("word_weights", {})
	var by_class: Dictionary = {"own": [], "universal": [], "other": []}
	for id: Variant in GameData.construct_word_ids(tier):
		(by_class[word_class(tier, str(id), held)] as Array).append(str(id))
	var total := 0.0
	for c: String in by_class:
		if not (by_class[c] as Array).is_empty():
			total += float(weights.get(c, 1.0))
	if total <= 0.0:
		return ""
	var roll: float = rng.randf() * total
	for c2: String in by_class:
		var pool: Array = by_class[c2]
		if pool.is_empty():
			continue
		roll -= float(weights.get(c2, 1.0))
		if roll <= 0.0:
			return str(pool[rng.randi() % pool.size()])
	for c3: String in ["universal", "own", "other"]:
		if not (by_class[c3] as Array).is_empty():
			return str((by_class[c3] as Array)[0])
	return ""


## What a keystone of this word does at `tier`, in general words (no skill yet): "+31% speed, -31%
## wind-up" - each op as a rune at the tier's keystone weight. For tooltips; on a skill, the effect is
## RingRules.keystone_effect.
static func effect_words(tier: String, id: String) -> String:
	var rr: RingRules = Runes.active() as RingRules
	var it: RuneInteraction = rr.effects_interaction() if rr != null else null
	if it == null or not it.has_method("op_words"):
		return ""
	var w: float = rr.keystone_weight(tier)
	var out: Array[String] = []
	for op: Dictionary in ops(tier, id):
		if str(op["op"]) == "mul":
			var o: Dictionary = op.duplicate()
			o["value"] = rr.keystone_mult(float(op["value"]), w)
			out.append(str(it.call("op_words", o, 1.0)))
		else:
			out.append(str(it.call("op_words", op, w)))
	return ", ".join(PackedStringArray(out))


## A tooltip for a carried construct: its title, its runes, what it means and what it does as a
## keystone, and whether it fits (when `held` is given).
static func tooltip(tier: String, id: String, held: Array = [], check_fit: bool = false) -> String:
	var w: Dictionary = word(tier, id)
	var lines: Array[String] = [title(tier, id)]
	var aff: String = affinity(tier, id)
	lines.append("%s word: %s" % ["Universal" if aff == "" else str(GameData.affinity(aff).get("label", aff.capitalize())), spelling(tier, id)])
	if str(w.get("meaning", "")) != "":
		lines.append(str(w["meaning"]))
	var rr: RingRules = Runes.active() as RingRules
	var fx: String = effect_words(tier, id)
	if fx != "":
		lines.append("As a keystone (x%s): %s" % [RingRules._x(rr.keystone_weight(tier)), fx])
	if check_fit:
		var f: Dictionary = fits(tier, id, held)
		if not bool(f["ok"]):
			lines.append("Does not fit: " + str(f["text"]))
	return "\n".join(PackedStringArray(lines))
